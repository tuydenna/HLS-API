// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  PENDING
  PUBLISHED
  ERROR
}

model Post {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  videoId     String     @unique @db.ObjectId
  authorId    String     @db.ObjectId
  slug        String     @unique
  title       String
  likes       Int        @default(0)
  views       Int        @default(0)
  description String
  thumbnail   String
  status      PostStatus @default(PENDING)
  searchIndex Int        @default(1)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author User @relation(fields: [authorId], references: [id])
  video  File @relation(fields: [videoId], references: [id])

  comments  Comment[]
  userPosts UserPost[]
  likePosts LikePost[]
}

model UserPost {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  postId String
  userId String
  user   User   @relation(fields: [userId], references: [id])
  post   Post   @relation(fields: [postId], references: [id])
}

model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String?
  email       String   @unique
  password    String
  avatar      String?
  token       String?
  userDir     String
  accessToken String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userPosts UserPost[]
  posts     Post[]
  likePosts LikePost[]
}

model LikePost {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  postId   String
  userId   String
  like     Boolean @default(false)
  userLike User    @relation(fields: [userId], references: [id])
  postLike Post    @relation(fields: [postId], references: [id])
}

model File {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  dirPath  String
  filePath String
  size     Float
  hasAudio Boolean   @default(true)
  quality  Quality[]
  duration Float     @default(0)
  post     Post?
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  author    Author
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   Post   @relation(fields: [postId], references: [id])
  postId String @db.ObjectId
}

// Address is an embedded document
type Video {
  title    String
  fileName String
}

type Author {
  id     String
  name   String
  avatar String
}

type Quality {
  name  String
  scale String
}
