{
    "watch": [
        "src"
    ],
    "ext": "ts,json",
    "ignore": [
        "node_modules",
        "dist",
        "logs",
        "build",
        "*.test.ts"
    ],
    "exec": [
        "npm run build && node ./build/server.js"
    ],
    "delay": "1000",
    "verbose": true,
    "env": {
        "NODE_ENV": "development"
    }
}