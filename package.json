{
    "name": "hls-core",
    "version": "1.0.3",
    "license": "xaio-din",
    "scripts": {
        "start": "node -r ./tsconfig-paths.js ./build/src/server.js",
        "start1": "node ./build/server.js",
        "swc": "swc src -d build",
        "node:dev": "node --watch-path=./src --watch -r ./tsconfig-paths.js ./build/src/server.js",
        "dev": "nodemon",
        "seed": "node ./build/database/seeders/user-seeder.js",
        "seed:post": "node ./build/database/seeders/post-seeder.js --loop=10000",
        "push": "npx prisma db push",
        "build": "tsc && tsc-alias",
        "mq-worker": "del /s /q build && npm run build && node ./build/lib/message-queue/mq-worker.js",
        "mq-worker1": "npm run build && node ./build/lib/message-queue/mq-worker.js"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1108.0",
        "@aws-sdk/lib-storage": "^3.1108.0",
        "@aws-sdk/s3-request-presigner": "^3.1108.0",
        "@faker-js/faker": "^8.4.1",
        "@prisma/client": "^5.18.0",
        "amqplib": "^0.10.8",
        "bcryptjs": "^3.0.2",
        "compression": "^1.8.1",
        "cookie-parser": "~1.4.4",
        "cors": "^2.8.5",
        "debug": "~2.6.9",
        "dotenv": "^16.4.5",
        "express": "5.0.0",
        "express-router-controller-khmer": "^1.5.4",
        "google-protobuf": "^3.21.4",
        "http-errors": "~1.6.3",
        "ioredis": "^5.6.1",
        "jsonwebtoken": "^9.0.2",
        "morgan": "~1.9.1",
        "protoc-gen-js": "^3.21.2",
        "rate-limiter-flexible": "^7.2.0",
        "tsconfig-paths": "^4.2.0"
    },
    "devDependencies": {
        "@swc/cli": "^0.8.1",
        "@swc/core": "^1.15.47",
        "@types/amqplib": "^0.10.7",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.6",
        "@types/cors": "^2.8.18",
        "@types/http-errors": "^2.0.4",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/logger": "^0.0.5",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^1.4.11",
        "@types/node": "^22.20.1",
        "concurrently": "^9.2.0",
        "nodemon": "^3.0.2",
        "prisma": "^5.18.0",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.16",
        "tsx": "^4.23.12",
        "typescript": "^5.9.3"
    }
}
