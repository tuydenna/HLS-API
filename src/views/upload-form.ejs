<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Bootstrap demo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <style>
        #form input, textarea {
            max-width: 500px;
           width: 500px;
        }
    </style>
</head>
<body>
<div class=" d-flex" style="justify-content: center; align-items: center; height: 100vh">
    <form action="" id="form">
            <h3>Create content</h3>
        <div class="mb-3">
            <label for="exampleFormControlInput1" class="form-label">Title</label>
            <input type="text" name="title" required class="form-control" id="exampleFormControlInput12">
        </div>
        <div class="mb-3">
            <label for="formFile" class="form-label">Thumbnail</label>
            <input class="form-control"  name="thumbnail" required  type="file" accept="image/png" id="formFile">
        </div>
        <div class="mb-3">
            <label for="exampleFormControlInput1" class="form-label">Author</label>
            <input type="text" class="form-control" name="author" required id="exampleFormControlInput1">
        </div>
        <div class="mb-3">
            <label for="formFile" class="form-label">Video</label>
            <input class="form-control" required type="file" name="video" id="formFile">
        </div>
        <div class="mb-3">
            <label for="exampleFormControlTextarea1" class="form-label">Description</label>
            <textarea class="form-control" id="exampleFormControlTextarea1" name="description" rows="3"></textarea>
        </div>
        <div class="mb-3">
            <button class="btn btn-sm  btn-outline-secondary">Save</button>
        </div>
    </form>

</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
<script>
    document.addEventListener("submit", async function (e) {
        e.preventDefault();
        const title = getInputVal('title');
        const author = getInputVal('author');
        const desc = document.querySelector(`textarea[name='description']`).value;
        const thumbnail = document.querySelector(`input[name='thumbnail']`).files[0];

        const formData = new FormData();
        formData.append("title", title);
        formData.append("author", author);
        formData.append("description", desc);
        formData.append("thumbnail", thumbnail);

        const {data} = await uploadVideo();
        formData.append("videoId", data.id);

        const response = await fetch("api/upload/content", {
            headers: {
                "Accept": "*/*"
            },
            method: "POST",
            body: formData
        })
        alert(response.ok)
        console.log(formData);
    })


    async function uploadVideo() {
        const file = document.querySelector(`input[name='video']`).files[0];
        const fileHeader = {
            "File-Extension": getFileExt(file),
            "File-Name": getFileName(file),
            "File-Size": file.size,
            "Content-Length": file.size
        }
        const respond = await fetch('/api/upload/video', {
            method: "POST",
            headers: {
                'Accept': 'multipart/form-data',
                "Content-Type": "application/octet-stream; charset=utf-8",
                ...fileHeader
            },
            body: file
        })
        if (respond.ok) {
            alert("Upload video succeed!");
        }

        return await respond.json();
    }

    function getFileExt(file) {
        try {
            let fileExt = file.name.split(".");
            fileExt = fileExt[fileExt.length-1];
            return fileExt;
        } catch (e) {
            throw ("File not valid!")
        }
    }

    function getFileName(file) {
        try {
            let fileExt = file.name.split(".");
            fileExt.pop();
            return encodeURI(fileExt.toString());
        } catch (e) {
            throw ("File not valid!")
        }
    }

    function getInputVal(name) {
        return document.querySelector(`input[name='${name}']`).value;
    }
</script>
</body>
</html>