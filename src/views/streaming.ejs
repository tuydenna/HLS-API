<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>
    <h1><%= title %></h1>
    <p>Welcome to <%= info %></p>
    <form id="form" action="#" method="post" enctype="multipart/form-data">
      <input id="file_data" name="file" type="file">
      <button type="submit" >Upload</button>
    </form>
    <p id="demo">
      
    </p>
    <script>
      document.getElementById("form").addEventListener("submit", async function (e) {
        e.preventDefault();
        const file = document.getElementById("file_data").files[0];
        const formData = new FormData();
        formData.append('file', file);
        const respond = await fetch('http://localhost:3080/api/streaming', {
          method: "POST",
          headers: {
            'Accept': 'application/json, application/xml, text/plain, text/html, multipart/form-data, *.*',
            "Content-Type": "multipart/form-data",
          },
          body: formData
        })
        console.log(respond.json());
      });
    </script>

  </body>
</html>
