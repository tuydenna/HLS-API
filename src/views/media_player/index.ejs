<script type="text/javascript">
    async function increaseLike(id) {
        const active = getElById("btn-like-post").getAttribute("aria-pressed");
        if (active === 'true') {
            const res = await fetch('/api/posts/' + id + '/increase-likes', {
                method: "PUT"
            });
            const data = await  res.json();
            if (res.ok) {
                getElById("like-post").innerText = data.likes;
            } else {
                alert("Likes Failed!");
            }
        } else {
            const res = await fetch('/api/posts/' + id + '/decrease-likes', {
                method: "PUT"
            });
            const data = await  res.json();
            if (res.ok) {
                getElById("like-post").innerText = data.likes;
            } else {
                alert("Likes Failed!");
            }
        }
    }
    function watchVideo(postId) {
        window.location = "/watch-videos/"+postId;
    }
</script>
