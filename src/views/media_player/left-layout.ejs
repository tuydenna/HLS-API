<% for(var i=0; i<allPosts.length; i++) {%>
<div class="flex mb-3 post-hover pr-1" onclick="watchVideo('<%= allPosts[i].id %>')">
    <div class="flex-none w-[55%] rounded w- h-[150px] bg-cover bg-[url('<%= allPosts[i].thumbnail %>')]" >
    </div>
    <div class="grow ml-3 ">
        <div class="flex-col">
            <div class="h-[50%]">
                <p class="text-lg line-clamp-2"><%= allPosts[i].title %></p>
            </div>
            <div class="grow pt-5">
                <div class="text-sm line-clamp-1"><%= allPosts[i].author.name %></div>
                <div class="text-sm line-clamp-1">33k views</div>
            </div>
        </div>

    </div>
</div>
<% } %>
