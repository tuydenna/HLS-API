<% for(var i=0; i<posts.length; i++) {%>
    <div class="flex w-full post-hover h-40 mb-4" onclick="watchVideo('<%= posts[i].id %>')">
        <div class="flex-none w-[55%] rounded  h-full bg-cover bg-[url('<%= posts[i].thumbnail %>')]" ></div>
        <div class="grow ml-3">
            <div class="h-[50%]">
                <p class="text-lg line-clamp-2"><%= posts[i].title %></p>
            </div>
            <div class="grow pt-5">
                <div class="text-sm line-clamp-1"><%= posts[i].author.name %></div>
                <div class="text-sm line-clamp-1">33k views</div>
            </div>
        </div>
    </div>
<% } %>
