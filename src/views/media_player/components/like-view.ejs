<div class="stats shadow">
    <div class="stat">
        <div class="stat-figure text-primary" onclick="increaseLike('<%= post.id %>')"  >
            <svg
                id="btn-like-post"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                class="inline-block h-8 w-8 stroke-current cursor-pointer">
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
        </div>
        <div class="stat-title">Likes</div>
        <div id="stat-likes" class=" stat-value text-primary"><%= post.likes %></div>
    </div>
    <div class="stat">
        <div class="stat-figure text-secondary">
            <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="<% if(data.post.likePosts.length) {%> blue <% } else {%> none <% } %>>"
                    viewBox="0 0 24 24"
                    class="inline-block h-8 w-8 stroke-current">
                <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
        </div>
        <div class="stat-title">Views</div>
        <div class="stat-value text-secondary">2.6M</div>
    </div>
</div>